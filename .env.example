# hhgoa-task3 -- environment template
#
#   cp .env.example .env       # then fill in what you need
#
# Nothing here is required to run the local-Hardhat half of the pipeline: with an
# empty .env, stages 1 and 5-8 work and stage 2 stops with a clear setup message.
# Never commit the filled-in .env.


# ===========================================================================
# 1. Google Gemini API (Google AI Studio / Google Labs) -- Stage 2 search
# ===========================================================================
# Free tier from Google AI Studio: https://aistudio.google.com/
# Recommended path -- no credit card or Google Cloud billing required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ===========================================================================
# 1b. Google Cloud Vision (optional alternative, requires billing account)
# ===========================================================================
# (a) Simplest: a plain API key, restricted to the Cloud Vision API.
GOOGLE_VISION_API_KEY=

# (b) Or: absolute path to a service-account JSON key file.
#     Takes effect only when GOOGLE_VISION_API_KEY is empty.
GOOGLE_APPLICATION_CREDENTIALS=

# Seconds to wait for the Vision API before giving up. Default 30.
# VISION_TIMEOUT=30


# ===========================================================================
# 2. Blockchain (stages 6-7)
# ===========================================================================
# Leave BOTH of these blank for the default: the local Hardhat node on
# http://127.0.0.1:8545, which is free, needs no signup and no wallet.
#
# Optional public-testnet path (e.g. Polygon Amoy) -- only if you want a real
# block-explorer link. Requires a wallet you control and free faucet funds:
#   RPC_URL=https://rpc-amoy.polygon.technology
#   PRIVATE_KEY=<64 hex chars of a THROWAWAY testnet key -- never a real wallet>
RPC_URL=
PRIVATE_KEY=

# Use an already-deployed FaceVerify instead of blockchain/deployment.json.
# FACEVERIFY_ADDRESS=

# Seconds to wait for a transaction receipt. Default 180 (raise for a testnet).
# TX_TIMEOUT=180


# ===========================================================================
# 3. Face model tuning (stage 1) -- all optional
# ===========================================================================
# InsightFace model pack: buffalo_l (default, accurate, ~275 MB download once)
# or buffalo_s (smaller and faster, same API).
# INSIGHTFACE_MODEL=buffalo_l

# Detector input resolution. Raise to 1024 to find smaller faces, at CPU cost.
# FACE_DET_SIZE=640

# Minimum detector confidence for a box to count as a face.
# FACE_DET_THRESHOLD=0.5

# Reject input images larger than this many bytes. Default 25 MB.
# FACE_MAX_IMAGE_BYTES=26214400


# ===========================================================================
# 4. Match decision + result filtering -- all optional
# ===========================================================================
# Cosine-distance threshold below which two faces are called the same person.
# 0.6 is a conservative ArcFace operating point. Lower = stricter.
# FACE_MATCH_THRESHOLD=0.6

# Comma-separated hosts to treat as social media. Setting this REPLACES the
# built-in list (Instagram, X/Twitter, Facebook, LinkedIn, TikTok, Reddit, ...).
# SOCIAL_DOMAINS=instagram.com,x.com,linkedin.com


# ===========================================================================
# 5. Matched-image download (stage 4) -- all optional
# ===========================================================================
# DOWNLOAD_TIMEOUT=30
# DOWNLOAD_MAX_BYTES=20971520
# DOWNLOAD_USER_AGENT=

# Allow fetching from private/loopback addresses. Off by default as an SSRF
# guard, since the URL being fetched comes from Google's response, not from you.
# Set to 1 only when pointing stage 4 at a local test fixture server.
# DOWNLOAD_ALLOW_PRIVATE_HOSTS=0
